# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# JWT signing key — any long random string, 32+ characters.
JWT_SIGNING_KEY=replace-with-a-long-random-string-at-least-32-chars

# Google OAuth Client ID — create one at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). Used to verify that Google
# ID tokens presented to /api/auth/google were actually issued for this app.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — defaults to a local SQLite file if not set.
SQLITE_CONNECTION_STRING=Data Source=faultmemoryloop.db

# Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash